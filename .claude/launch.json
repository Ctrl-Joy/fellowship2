{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd backend && .\\mvnw.cmd -q spring-boot:run -Dspring-boot.run.jvmArguments=-Dstrata.storage.local-dir=../.dev/uploads"
      ],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": false
    }
  ]
}