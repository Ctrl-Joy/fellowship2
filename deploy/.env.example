# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env (chmod 600) and fill in EVERY value.
# Never commit deploy/.env. The backend's prod profile refuses to start with development defaults (D-026).

# --- Public address (DNS must point here; Caddy gets the TLS certificate automatically)
STRATA_DOMAIN=strata.example.com
ACME_EMAIL=ops@example.com

# --- Database
DATABASE_USER=strata
DATABASE_PASSWORD=          # openssl rand -base64 32
DATABASE_POOL_SIZE=15

# --- Redis (rate limits, feed cache)
REDIS_PASSWORD=             # openssl rand -hex 24

# --- Object storage (MinIO in this stack). For AWS S3 instead, see docs/DEPLOYMENT.md.
MINIO_ROOT_USER=strata
MINIO_ROOT_PASSWORD=        # openssl rand -base64 32
S3_BUCKET=strata

# --- Secrets the API refuses to start without
JWT_SECRET=                 # openssl rand -base64 48
FILE_VISITOR_SALT=          # openssl rand -hex 32
FUNDING_DEMO_WEBHOOK_SECRET=  # openssl rand -hex 32

# --- Mail (verification and password-reset links)
MAIL_MODE=smtp
MAIL_FROM=no-reply@strata.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Optional
ANTHROPIC_API_KEY=          # Community AI; without it, answers are offline cited summaries
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
FUNDING_ENABLED=true        # demo mode only (D-022)
SEED_DEMO_DATA=false        # never true for a real community
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
GRAFANA_ADMIN_PASSWORD=     # only with --profile monitoring
# Prebuilt images (CI) instead of building on the server:
# STRATA_BACKEND_IMAGE=ghcr.io/your-org/strata-backend:1.2.3
# STRATA_WEB_IMAGE=ghcr.io/your-org/strata-web:1.2.3
