# Copy to .env and fill in. Never commit .env.

# --- Database
DATABASE_USER=strata
DATABASE_PASSWORD=change-me-to-a-long-random-string

# --- Auth: base64 of >= 32 random bytes.  Generate:  openssl rand -base64 48
JWT_SECRET=

# --- Public URL the browser uses (emails link here; also the allowed CORS origin)
APP_PUBLIC_URL=http://localhost:8088
WEB_PORT=8088
# true behind HTTPS (production)
COOKIE_SECURE=false

# --- Mail: "log" prints verification/reset links to the backend log; "smtp" sends real mail
MAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Community AI (optional). Without a key, answers are cited retrieval summaries (offline mode).
# The key stays on the server; it is never sent to the browser.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# --- Object storage (SeaweedFS in docker-compose.yml; any S3-compatible service in production). See docs/DEPLOYMENT.md.
# STORAGE_DRIVER=s3 (default in compose) or local (files in the uploads volume).
STORAGE_DRIVER=s3
# Credentials for the bundled SeaweedFS S3 service (or your own S3 bucket).
S3_ACCESS_KEY=strata
S3_SECRET_KEY=change-me-to-another-long-random-string
S3_BUCKET=strata

# --- Secrets that production refuses to start without (prod profile, D-026)
# Salt for hashing share-link visitor IPs:  openssl rand -hex 32
FILE_VISITOR_SALT=
# Demo funding webhook HMAC secret (>= 16 chars):  openssl rand -hex 32
FUNDING_DEMO_WEBHOOK_SECRET=

# --- Moderator funding provider (D-034): demo (simulated money) or stripe (hosted Checkout, test mode)
FUNDING_PROVIDER=demo
# Stripe test keys from the Stripe dashboard (Developers -> API keys). Placeholders only; never commit real keys.
STRIPE_SECRET_KEY=
# Webhook signing secret (dashboard endpoint, or printed by `stripe listen`)
STRIPE_WEBHOOK_SECRET=
# A live key (sk_live_) is refused unless BOTH are set after the compliance review (KYC, payouts, tax, money transmission)
FUNDING_LIVE_MODE=false
FUNDING_COMPLIANCE_ACK=

# --- Demo content (clearly fictional demo accounts). Set false in production.
SEED_DEMO_DATA=true
# "prod" enables secure cookies and disables seeding by default
SPRING_PROFILES_ACTIVE=default
